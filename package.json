{
  "name": "claude-clock",
  "version": "1.0.1",
  "description": "TUI utility for scheduling Claude Code build sessions during off-peak hours",
  "main": "dist/cli.js",
  "type": "module",
  "bin": {
    "claude-clock": "dist/cli.js"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "tui": "node dist/index.js",
    "daemon": "node dist/cli.js daemon",
    "dev": "tsc && node dist/cli.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "claude",
    "claude-code",
    "scheduler",
    "tui",
    "terminal",
    "automation",
    "anthropic"
  ],
  "author": "yangwao",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yangwao/claude-clock.git"
  },
  "homepage": "https://github.com/yangwao/claude-clock#readme",
  "bugs": {
    "url": "https://github.com/yangwao/claude-clock/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "date-fns": "^3.6.0",
    "ink": "^4.4.1",
    "ink-select-input": "^5.0.0",
    "react": "^18.2.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/uuid": "^9.0.7",
    "typescript": "^5.3.3"
  }
}
